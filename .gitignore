```gitignore
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
.tern-port

# Dependencies
node_modules/
bower_components/
jspm_packages/
web_modules/
.pnp.*

# Build outputs
dist/
dist-ssr/
build/
build/Release/
.next/
out/
.nuxt/
.vuepress/dist/
.docusaurus/
.serverless/

# Test coverage
coverage/
.nyc_output/
*.lcov
lib-cov/

# Environment variables
.env
.env.*
!.env.example

# Caches
.cache/
.parcel-cache/
.npm/
.grunt/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.temp/

# TypeScript and lint caches
*.tsbuildinfo
.eslintcache
.stylelintcache

# Package manager artifacts
.lock-wscript
.yarn-integrity
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
*.tgz

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.vscode-test/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store

# REPL history
.node_repl_history

# Other generated files
.cache/
.dynamodb/
